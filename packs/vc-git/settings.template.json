{
  "permissions": {
    "allow": [
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(git worktree list:*)",
      "Bash(git branch --show-current)",
      "Bash(git stash list:*)",
      "Bash(git config --get:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(git commit:*)",
      "Bash(py .claude/references/vc-git/tree-remove.py:*)",
      "Bash(py .claude/references/vc-git/pre-commit-check.py --range:*)",
      "Bash(git add:*)",
      "Bash(git switch:*)",
      "Bash(git branch)",
      "Bash(git branch --list)",
      "Bash(git branch -l)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --all)",
      "Bash(git branch --remotes)",
      "Bash(git branch -a -v)",
      "Bash(git check-ignore:*)",
      "Bash(git show-ref:*)",
      "Bash(git stash create:*)",
      "Bash(git stash store:*)"
    ],
    "ask": [
      "Bash(git worktree remove --force:*)",
      "Bash(git worktree remove -f:*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean:*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .)",
      "Bash(git restore:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git push:*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch --force*)",
      "Bash(git switch * --force*)",
      "Bash(git switch -C*)",
      "Bash(git switch * -C*)",
      "Bash(git branch -f*)",
      "Bash(git branch * -f*)",
      "Bash(git branch --force*)",
      "Bash(git branch * --force*)",
      "Bash(git branch -M*)",
      "Bash(git branch * -M*)",
      "Bash(git branch -df*)",
      "Bash(git branch * -df*)",
      "Bash(git branch -C*)",
      "Bash(git branch * -C*)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(*git*)", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-git/vc-guard-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-git/vc-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\"" }
        ]
      }
    ]
  }
}
