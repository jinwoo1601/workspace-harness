{
  "permissions": {
    "allow": [
      "Bash(cm workspace create:*)",
      "Bash(cm status:*)",
      "Bash(cm wi:*)",
      "Bash(cm find:*)",
      "Bash(cm log:*)",
      "Bash(cm diff:*)",
      "Bash(MSYS_NO_PATHCONV=1 cm find:*)",
      "Bash(cm merge * --machinereadable)",
      "Bash(MSYS_NO_PATHCONV=1 cm merge * --machinereadable)",
      "Bash(cm cat:*)",
      "Bash(cm workspace list:*)",
      "Bash(cm history:*)",
      "Bash(cm add:*)",
      "Bash(cm ci:*)",
      "Bash(MSYS_NO_PATHCONV=1 cm cat:*)",
      "Bash(MSYS_NO_PATHCONV=1 cm diff:*)",
      "Bash(MSYS_NO_PATHCONV=1 cm log:*)",
      "Bash(py .claude/references/vc-plastic/clean-read.py:*)",
      "Bash(py .claude/references/vc-plastic/tree-remove.py:*)"
    ],
    "ask": [
      "Bash(cm workspace delete:*)",
      "Bash(cm undo:*)",
      "Bash(cm rm:*)",
      "Bash(cm branch delete:*)",
      "Bash(cm merge *--merge*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(*cm*)", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-plastic/vc-guard-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/vc-plastic/vc-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\"" }
        ]
      }
    ]
  }
}
