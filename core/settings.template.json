{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(which:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(comm:*)",
      "Bash(cmp:*)",
      "Bash(tr:*)",
      "Bash(rev:*)",
      "Bash(nl:*)",
      "Bash(fold:*)",
      "Bash(paste:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(sleep:*)",
      "Bash(true:*)",
      "Bash(date:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(od:*)",
      "Bash(sha256sum:*)",
      "Bash(seq:*)",
      "Bash(test:*)",
      "Bash(cygpath:*)",
      "Bash(realpath:*)",
      "WebSearch",
      "Bash(py scripts/harness.py list:*)",
      "Bash(py scripts/harness.py validate:*)",
      "Bash(py scripts/harness.py doctor:*)",
      "Bash(py scripts/harness.py outline:*)",
      "Bash(py scripts/harness.py budget:*)",
      "Bash(py scripts/harness.py bounds:*)",
      "Bash(py scripts/harness.py upgrade --dry-run:*)",
      "Bash(py scripts/hub.py sessions-at:*)",
      "Bash(py scripts/hub.py predecessor:*)",
      "Bash(py scripts/hub.py write:*)",
      "Bash(claude agents:*)",
      "Bash(claude stop:*)",
      "Bash(claude --bg:*)",
      "Bash(CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1 claude --bg:*)",
      "Bash(claude --background:*)",
      "Bash(CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1 claude --background:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(shred:*)",
      "Bash(dd:*)",
      "Bash(claude *dangerously-skip-permissions*)",
      "Bash(claude *bypassPermissions*)"
    ],
    "ask": [
      "Bash(sed -n -i*)",
      "Bash(sed -n * -i*)",
      "Bash(sed -n --in-place*)",
      "Bash(sed -n * --in-place*)",
      "Bash(claude --settings*)",
      "Bash(claude *--settings*)",
      "Bash(claude --setting-sources*)",
      "Bash(claude *--setting-sources*)",
      "Bash(claude --allowedTools*)",
      "Bash(claude *--allowedTools*)",
      "Bash(claude --add-dir*)",
      "Bash(claude *--add-dir*)",
      "Bash(claude --allowed-tools*)",
      "Bash(claude *--allowed-tools*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/doctor-hook.py\" \"${CLAUDE_PROJECT_DIR}\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/agent-guard-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/agent-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\"" }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|SendMessage",
        "hooks": [
          { "type": "command", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/write-guard-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/write-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(*rm*)", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" \"${CLAUDE_PROJECT_DIR}\"", "timeout": 10 },
          { "type": "command", "if": "Bash(*rM*)", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" \"${CLAUDE_PROJECT_DIR}\"", "timeout": 10 },
          { "type": "command", "if": "Bash(*Rm*)", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" \"${CLAUDE_PROJECT_DIR}\"", "timeout": 10 },
          { "type": "command", "if": "Bash(*RM*)", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/rm-fence-hook.py\" \"${CLAUDE_PROJECT_DIR}\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(*--b*)", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/write-guard-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/write-guard-hook.py\" \"${CLAUDE_PROJECT_DIR}\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/context-bound-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/context-bound-hook.py\" \"${CLAUDE_PROJECT_DIR}\"", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/report-filer-hook.py\" \"${CLAUDE_PROJECT_DIR}\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/harness.json\" ] && [ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/references/core/stop-line-hook.py\" ] || py \"${CLAUDE_PROJECT_DIR}/.claude/references/core/stop-line-hook.py\" \"${CLAUDE_PROJECT_DIR}\"", "timeout": 10 }
        ]
      }
    ]
  }
}
